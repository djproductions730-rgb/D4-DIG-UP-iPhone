{
  "firestore": {
    "rules": "firestore.rules"
  },
  "hosting": {
    "site": "d4-trip",
    "public": ".",
    "ignore": [
      "firebase.json",
      "firebase.invites.json",
      "team-invites/**",
      "**/.*",
      "**/node_modules/**",
      "**/*.cjs",
      "**/*.md",
      "**/*.rules",
      "**/*debug.log",
      "**/package*.json",
      "trip-push/**"
    ],
    "headers": [
      {
        "source": "**",
        "headers": [
          {
            "key": "X-Content-Type-Options",
            "value": "nosniff"
          },
          {
            "key": "Referrer-Policy",
            "value": "strict-origin-when-cross-origin"
          }
        ]
      },
      {
        "source": "/sw.js",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache"
          }
        ]
      },
      {
        "source": "/index.html",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache"
          }
        ]
      },
      {
        "source": "/",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache, must-revalidate"
          }
        ]
      },
      {
        "source": "/reference-premium.js",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache, must-revalidate"
          }
        ]
      },
      {
        "source": "/reference-premium.css",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache, must-revalidate"
          }
        ]
      },
      {
        "source": "/goa-milestones.js",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache, must-revalidate"
          }
        ]
      },
      {
        "source": "/premium-production.js",
        "headers": [
          {
            "key": "Cache-Control",
            "value": "no-cache, must-revalidate"
          }
        ]
      }
    ]
  },
  "emulators": {
    "firestore": {
      "port": 8088
    },
    "ui": {
      "enabled": false
    }
  },
  "functions": [
    {
      "source": "trip-push",
      "codebase": "trip-push"
    }
  ]
}
