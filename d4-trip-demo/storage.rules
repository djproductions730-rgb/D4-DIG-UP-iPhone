rules_version = '2';
service firebase.storage {
  match /b/{bucket}/o {
    // Ticket images are private to approved members of the matching shared trip.
    // Unrelated storage paths remain denied by default.
    match /tripTickets/{tripId}/{direction}/{ticketId} {
      function loggedIn() { return request.auth != null; }
      function owner() {
        return loggedIn() && request.auth.token.email_verified == true &&
          request.auth.uid == '2FYUUnPp1JX8wvv9HSvL6QoyaCq2';
      }
      function hasEmailGrant() {
        return loggedIn() && request.auth.token.email_verified == true &&
          request.auth.token.email is string &&
          firestore.exists(/databases/(default)/documents/teamTrips/$(tripId)/access/$(request.auth.token.email.lower()));
      }
      function hasUidGrant() {
        return loggedIn() &&
          firestore.exists(/databases/(default)/documents/teamTrips/$(tripId)/accessUid/$(request.auth.uid));
      }
      function emailRole() {
        return firestore.get(/databases/(default)/documents/teamTrips/$(tripId)/access/$(request.auth.token.email.lower())).data.role;
      }
      function uidRole() {
        return firestore.get(/databases/(default)/documents/teamTrips/$(tripId)/accessUid/$(request.auth.uid)).data.role;
      }
      function viewer() {
        return owner() ||
          (hasEmailGrant() && emailRole() in ['member','admin']) ||
          (hasUidGrant() && uidRole() in ['member','admin']);
      }
      function editor() {
        return owner() ||
          (hasEmailGrant() && emailRole() == 'admin') ||
          (hasUidGrant() && uidRole() == 'admin');
      }
      function validImage() {
        return direction in ['up','down'] && ticketId.size() >= 6 && ticketId.size() <= 100 &&
          request.resource.size > 0 && request.resource.size <= 15 * 1024 * 1024 &&
          request.resource.contentType.matches('image/.*');
      }
      allow get: if viewer();
      allow list: if false;
      allow create: if editor() && validImage();
      allow update: if false;
      allow delete: if editor();
    }
  }
}