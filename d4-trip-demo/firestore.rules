rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function signedIn() {
      return request.auth != null;
    }

    // Private, authenticated cross-device backup/sync for the same Firebase UID.
    // This is NOT a shared trip permissions model.
    match /users/{userId}/snapshots/{snapshotId} {
      function isOwner() {
        return signedIn() &&
          request.auth.uid == userId &&
          snapshotId == 'primary';
      }

      function validSnapshot() {
        return request.resource.data.keys().hasAll(
          ['data', 'revision', 'updatedBy', 'updatedAt']) &&
          request.resource.data.keys().hasOnly(
          ['data', 'revision', 'updatedBy', 'updatedAt']) &&
          request.resource.data.data is map &&
          request.resource.data.data.trips is list &&
          request.resource.data.revision is int &&
          request.resource.data.revision > 0 &&
          request.resource.data.updatedBy == request.auth.uid &&
          request.resource.data.updatedAt == request.time;
      }

      allow get: if isOwner();
      allow list: if false;
      allow create: if isOwner() && validSnapshot() &&
        request.resource.data.revision == 1;
      allow update: if isOwner() && validSnapshot() &&
        request.resource.data.revision == resource.data.revision + 1;
      allow delete: if false;
    }

    // A grant binds an Auth-verified email to one trip. Only D can assign admins.
    match /teamTrips/{tripId} {
      function verified() {
        return request.auth != null && request.auth.token.email_verified == true;
      }
      function mainAdmin() {
        return verified() && request.auth.uid == '2FYUUnPp1JX8wvv9HSvL6QoyaCq2';
      }
      function access() {
        return get(/databases/$(database)/documents/teamTrips/$(tripId)/access/$(request.auth.token.email.lower())).data;
      }
      function hasEmailGrant() {
        return verified() && exists(/databases/$(database)/documents/teamTrips/$(tripId)/access/$(request.auth.token.email.lower()));
      }
      function editor() { return mainAdmin() || (hasEmailGrant() && access().role == 'admin'); }
      function guestMember() {
        return signedIn() &&
          exists(/databases/$(database)/documents/teamTrips/$(tripId)/accessUid/$(request.auth.uid)) &&
          get(/databases/$(database)/documents/teamTrips/$(tripId)/accessUid/$(request.auth.uid)).data.role == 'member';
      }
      function validTrip() {
        let d = request.resource.data;
        return d.keys().hasOnly(['trip','revision','updatedBy','updatedAt']) &&
          d.trip is map && d.trip.id == tripId && d.trip.name is string &&
          d.trip.name.size() > 0 && d.trip.name.size() <= 75 &&
          d.trip.members is list && d.trip.members.size() <= 100 &&
          d.trip.expenses is list && d.trip.expenses.size() <= 1000 &&
          d.revision is int && d.updatedBy == request.auth.uid && d.updatedAt == request.time;
      }
      allow get: if mainAdmin() || (hasEmailGrant() && access().role in ['member','admin']) || guestMember();
      // Only the designated, email-verified Main Admin may enumerate shared trips
      // to receive join request notifications across devices and browser sessions.
      allow list: if mainAdmin();
      allow create: if mainAdmin() && validTrip() && request.resource.data.revision == 1;
      // Trip Admins can add names, but only Main Admin can remove, rename,
      // archive or restore people and change role-bearing roster entries.
      function adminRosterAppendOnly() {
        let before = resource.data.trip;
        let after = request.resource.data.trip;
        return after.members.hasAll(before.members) &&
          after.get('archivedMembers', []) == before.get('archivedMembers', []) &&
          after.get('admins', []) == before.get('admins', []);
      }
      allow update: if editor() && validTrip() &&
        (mainAdmin() || adminRosterAppendOnly()) &&
        request.resource.data.revision == resource.data.revision + 1;
      // Deleting an entire shared trip is a separate Main Admin-only destructive action.
      // The client deletes all verified-email access grants in the same transaction.
      allow delete: if mainAdmin();
      // Approval-based link joining, independent from old verified-email grants.
      // A guest can only see their own request; trip details remain private until
      // a trusted admin transaction approves AND grants this exact Firebase UID.
      match /joinRequests/{guestUid} {
        function ownRequest() {
          return signedIn() && request.auth.uid == guestUid;
        }
        function validNewRequest() {
          let d = request.resource.data;
          return ownRequest() &&
            exists(/databases/$(database)/documents/teamTrips/$(tripId)) &&
            d.keys().hasAll(['uid','name','status','createdAt']) &&
            d.keys().hasOnly(['uid','name','status','createdAt']) &&
            d.uid == guestUid &&
            d.name is string && d.name.size() >= 2 && d.name.size() <= 50 &&
            d.status == 'pending' &&
            d.createdAt == request.time;
        }
        function validDecision() {
          let d = request.resource.data;
          let grantPath = /databases/$(database)/documents/teamTrips/$(tripId)/accessUid/$(guestUid);
          let tripPath = /databases/$(database)/documents/teamTrips/$(tripId);
          return editor() && resource.data.status == 'pending' &&
            d.keys().hasAll(['uid','name','status','createdAt','joinedName','decidedAt','decidedByUid','decidedByEmail']) &&
            d.keys().hasOnly(['uid','name','status','createdAt','joinedName','decidedAt','decidedByUid','decidedByEmail']) &&
            d.uid == guestUid && d.name == resource.data.name &&
            d.createdAt == resource.data.createdAt &&
            d.joinedName is string && d.joinedName.size() <= 70 &&
            d.decidedAt == request.time &&
            d.decidedByUid == request.auth.uid &&
            d.decidedByEmail == request.auth.token.email &&
            ( (d.status == 'rejected' && d.joinedName == '') ||
              (d.status == 'approved' && d.joinedName.size() >= 2 &&
                getAfter(grantPath).data.role == 'member' &&
                getAfter(grantPath).data.name == d.joinedName &&
                getAfter(tripPath).data.trip.members.hasAny([d.joinedName])) );
        }
        // A guest may refresh their own pending request or retry after a rejection.
        // Never allow a resend to undo approval, alter a grant or create a member.
        function validResendRequest() {
          let d = request.resource.data;
          return ownRequest() &&
            resource.data.status in ['pending','rejected'] &&
            d.keys().hasAll(['uid','name','status','createdAt']) &&
            d.keys().hasOnly(['uid','name','status','createdAt']) &&
            d.uid == guestUid &&
            d.name is string && d.name.size() >= 2 && d.name.size() <= 50 &&
            d.status == 'pending' && d.createdAt == request.time;
        }
        allow get: if ownRequest() || editor();
        allow list: if editor();
        allow create: if validNewRequest();
        allow update: if validDecision() || validResendRequest();
        allow delete: if mainAdmin();
      }
      match /accessUid/{guestUid} {
        function ownGrant() { return signedIn() && request.auth.uid == guestUid; }
        function validApprovedGrant() {
          let d = request.resource.data;
          let joinPath = /databases/$(database)/documents/teamTrips/$(tripId)/joinRequests/$(guestUid);
          return editor() &&
            d.keys().hasAll(['role','name','grantedAt','grantedByUid']) &&
            d.keys().hasOnly(['role','name','grantedAt','grantedByUid']) &&
            d.role == 'member' && d.name is string &&
            d.name.size() >= 2 && d.name.size() <= 70 &&
            d.grantedAt == request.time && d.grantedByUid == request.auth.uid &&
            get(joinPath).data.status == 'pending' &&
            getAfter(joinPath).data.status == 'approved' &&
            getAfter(joinPath).data.joinedName == d.name &&
            getAfter(joinPath).data.decidedByUid == request.auth.uid;
        }
        allow get: if ownGrant() || editor();
        allow list: if mainAdmin();
        allow create: if validApprovedGrant();
        allow update: if false;
        // Even Trip Admins cannot reinstate a member after Main Admin removes access.
        allow delete: if mainAdmin();
      }
      match /access/{email} {
        function validGrant() {
          let d = request.resource.data;
          return exists(/databases/$(database)/documents/teamTrips/$(tripId)) &&
            email.size() <= 254 && d.keys().hasOnly(['role']) && d.role in ['member','admin'];
        }
        allow get: if mainAdmin() || (verified() && request.auth.token.email.lower() == email);
        allow list: if mainAdmin();
        allow create: if verified() && validGrant() && (mainAdmin() || (editor() && request.resource.data.role == 'member'));
        allow update: if mainAdmin() && validGrant();
        // Code-joined and email-invited users can only be removed by Main Admin.
        allow delete: if mainAdmin();
      }
    }
    match /{document=**} {
      allow read, write: if false;
    }
  }
}
